    "/api/user-mgmt/v1/users": {
      "get": {
        "summary": "List User entities via all-users",
        "operationId": "listAllUsers",
        "tags": [
          "all-users"
        ],
        "parameters": [
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "The next value of the previous page",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "orderBy",
            "in": "query",
            "required": false,
            "description": "Comma-separated list of field_name or field_name asc|desc",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated field names for sparse fieldset selection",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "TSL filter expression for searching entities",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Authz-Revocation-After",
            "in": "header",
            "required": false,
            "description": "The identity of the caller's own revocation, or its Authz-Revocation-Location path: the request waits until the revocation is no longer pending, within Prefer: wait=N and the wait cap, and then shows the write",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Prefer",
            "in": "header",
            "required": false,
            "description": "wait=N: wait at most N seconds for the revocation (RFC 7240)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "Authz-Revocation": {
                "description": "The state of the revocation that Authz-Revocation-After names, or unknown when it is not one of the caller's own; absent with no Authz-Revocation-After",
                "schema": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "complete",
                    "parked",
                    "failed",
                    "expired",
                    "unknown"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "allOf": [
                          {
                            "$ref": "#/components/schemas/User"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "href": {
                                "type": "string"
                              },
                              "id": {
                                "type": "string"
                              },
                              "kind": {
                                "type": "string"
                              }
                            }
                          }
                        ]
                      }
                    },
                    "kind": {
                      "type": "string"
                    },
                    "next": {
                      "type": "string"
                    },
                    "size": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request: the Authz-Revocation-After header is not the identity of a revocation, or the request is not valid"
          }
        }
      }
    },
    "/authz/revocations/{id}": {
      "get": {
        "summary": "Read the state of the caller's own revocation",
        "operationId": "readRevocation",
        "tags": [
          "authz"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The identity of the revocation",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Prefer",
            "in": "header",
            "required": false,
            "description": "wait=N: wait at most N seconds, and at most the wait cap, while the revocation is pending (RFC 7240)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The state of the revocation",
            "headers": {
              "Authz-Revocation": {
                "description": "The state of the revocation",
                "schema": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "complete",
                    "parked",
                    "failed",
                    "expired"
                  ]
                }
              },
              "Preference-Applied": {
                "description": "wait=N with the seconds that the route allowed",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "complete",
                        "parked",
                        "failed",
                        "expired"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "state"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found: no revocation of the caller has the identity"
          }
        }
      }
    }
  },
