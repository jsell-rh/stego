func clearCookie(w http.ResponseWriter,name string){setCookie(w,name,"",-1)}
func response(w http.ResponseWriter,code int,value any){w.Header().Set("Content-Type","application/json");w.WriteHeader(code);_ = json.NewEncoder(w).Encode(value)}
func failure(w http.ResponseWriter,code int){response(w,code,map[string]string{"error":http.StatusText(code)})}
