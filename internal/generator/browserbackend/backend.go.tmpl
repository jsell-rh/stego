func cookieID(r *http.Request,name string)string{value:="";count:=0;for _,cookie:=range r.Cookies(){if cookie.Name==name{count++;value=cookie.Value}};if count!=1{return ""};if _,err:=sessionHash(value);err!=nil{return ""};return value}
