 outcome:="aborted";defer func(){finish(outcome)}()
 err:=action(ctx)
 switch{case err==nil:outcome="success";case errors.Is(err,context.DeadlineExceeded):outcome="deadline";case errors.Is(err,context.Canceled):outcome="canceled";default:outcome="failure"}
 return err
}
