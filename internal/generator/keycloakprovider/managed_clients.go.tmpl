// {{.Name}}ClientIdentity composes the identity of a managed {{.Kind}} client
// from trusted application state. Ownership attributes carry the reserved
// stego.owner prefix; {{if .Legacy}}legacy attributes are also declared for
// reads of clients that have not migrated yet{{else}}the kind has no legacy
// form{{end}}.
func {{.Name}}ClientIdentity({{.TemplateParams}}) (ClientIdentity, error) {
{{- if .EmptyCheck}}
	if {{.EmptyCheck}} {
		return ClientIdentity{}, ErrOwnership
	}
{{- end}}
	return ClientIdentity{
		ClientID: {{.ClientIDExpr}},
		Ownership: map[string]string{
		{{- range .Attributes}}
			"stego.owner.{{.Key}}": {{.ValueExpr}},
		{{- end}}
		},
		{{- if .Legacy}}
		LegacyAttributes: map[string]string{
		{{- range .Attributes}}
			"{{.Key}}": {{.ValueExpr}},
		{{- end}}
		},
		LegacyRenames: map[string]string{
		{{- range .Attributes}}
			"{{.Key}}": "stego.owner.{{.Key}}",
		{{- end}}
		},
		{{- end}}
	}, nil
}
