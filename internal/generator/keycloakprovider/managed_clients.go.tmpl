// managedClientBinding resolves the ownership binding of a managed client
// kind. A nil client, a foreign client name, mixed legacy and current
// attributes, or missing ownership keys reject the client with ErrOwnership.
func managedClientBinding(identity ClientIdentity, live *ClientRepresentation{{if .LegacyKinds}}, legacyClientID string{{else}}, _ string{{end}}) (ClientBinding, error) {
	if live == nil {
		return ClientBinding{}, ErrOwnership
	}
	clientID := identity.ClientID
{{- if .LegacyKinds}}
	if identity.LegacyAttributes != nil && legacyClientID != "" {
		clientID = legacyClientID
	}
{{- end}}
	if live.ClientID != clientID {
		return ClientBinding{}, ErrOwnership
	}
	attributes := identity.LegacyAttributes
	current := false
	for key := range identity.Ownership {
		if _, present := live.Attributes[key]; present {
			current = true
		}
	}
	if current {
		if clientID != identity.ClientID {
			return ClientBinding{}, ErrOwnership
		}
		for key := range identity.LegacyAttributes {
			if _, present := live.Attributes[key]; present {
				return ClientBinding{}, ErrOwnership
			}
		}
		attributes = identity.Ownership
	} else if attributes == nil {
		return ClientBinding{}, ErrOwnership
	}
	binding := ClientBinding{ID: live.ID, ClientID: clientID, Attributes: attributes}
	if err := binding.CheckOwnership(*live); err != nil {
		return ClientBinding{}, err
	}
	return binding, nil
}
