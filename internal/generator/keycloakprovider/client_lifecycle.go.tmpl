package {{.Package}}

import (
 "bytes"
 "context"
 "crypto/rand"
 "encoding/hex"
 "encoding/json"
 "errors"
 "fmt"
 "maps"
 "reflect"

 runtime "{{.Controller}}"
)

var ErrClientLifecycle = errors.New("Keycloak client lifecycle record is invalid")
var ErrClientClosed = errors.New("Keycloak client lifecycle is closed")

// ClientIdentity comes from trusted application state. Legacy keys are
// optional. Their exact rename must produce Ownership without changed values.
type ClientIdentity struct {
 ClientID string
 Ownership map[string]string
 LegacyAttributes map[string]string
 LegacyRenames map[string]string
}
func(i ClientIdentity)binding(id string)ClientBinding{return ClientBinding{ID:id,ClientID:i.ClientID,Attributes:maps.Clone(i.Ownership)}}
func(i ClientIdentity)validate()error{
 if _,err:=oidcClientConfiguration(i.binding("validation"),"",300);err!=nil{return err}
 if len(i.LegacyAttributes)==0{
  if len(i.LegacyRenames)!=0{return ErrClientLifecycle};return nil
 }
 plan:=ClientOwnershipMigration{Prior:ClientBinding{ID:"validation",ClientID:i.ClientID,Attributes:i.LegacyAttributes},Renames:i.LegacyRenames}
 next,err:=plan.NextBinding();if err!=nil{return err}
 if !reflect.DeepEqual(next.Attributes,i.Ownership){return ErrClientLifecycle};return nil
}

type clientLifecycleRecord struct {
 Version int `json:"version"`
 Kind string `json:"kind,omitempty"`
 Subject string `json:"subject,omitempty"`
 Phase string `json:"phase"`
 Closed bool `json:"closed"`
 Binding ClientBinding `json:"binding"`
 Migration string `json:"migration,omitempty"`
}
func(clientLifecycleRecord)Format(s fmt.State,_ rune){_,_=s.Write([]byte("[protected client lifecycle]"))}

func(r clientLifecycleRecord)validate(i ClientIdentity,kind string)error{
 if r.Kind!=kind{return ErrClientLifecycle}
 if r.Subject!=""&&(kind!="service-account"||r.Phase!="bound"||!identifier.MatchString(r.Subject)){return ErrClientLifecycle}
 if r.Version!=1||r.Binding.validate()!=nil||r.Binding.ClientID!=i.ClientID{return ErrClientLifecycle}
 switch r.Phase{
 case "allocated","bound":
  if r.Migration!=""||!reflect.DeepEqual(r.Binding.Attributes,i.Ownership){return ErrClientLifecycle}
 case "legacy","migration":
  if len(i.LegacyAttributes)==0||!reflect.DeepEqual(r.Binding.Attributes,i.LegacyAttributes){return ErrClientLifecycle}
  if r.Phase=="legacy"{if r.Migration!=""{return ErrClientLifecycle};return nil}
  plan,err:=RestoreOwnershipMigration(r.Migration);if err!=nil{return err}
  if !reflect.DeepEqual(plan.Prior,r.Binding)||!reflect.DeepEqual(plan.Renames,i.LegacyRenames){return ErrClientLifecycle}
 default:return ErrClientLifecycle
 }
 return nil
}

type clientLifecycleProvider interface {
 FindClient(context.Context,string)(ClientRepresentation,error)
 DiscoverOwnedClient(context.Context,string,map[string]string)(ClientBinding,error)
 InspectClient(context.Context,ClientBinding)(ClientRepresentation,error)
 DisableClient(context.Context,ClientBinding)error
 PrepareClientOwnershipMigration(context.Context,ClientBinding,map[string]string)(ClientOwnershipMigration,error)
 MigrateClientOwnership(context.Context,ClientOwnershipMigration)(ClientBinding,error)
 DeleteClient(context.Context,ClientBinding)error
}

// clientLifecycle shares saved identity, migration, and closure boundaries.
type clientLifecycle struct {
 provider clientLifecycleProvider
 journal *runtime.StateJournal
 identity ClientIdentity
 kind string
}
func(clientLifecycle)Format(s fmt.State,_ rune){_,_=s.Write([]byte("[protected client lifecycle]"))}
func(clientLifecycle)MarshalJSON()([]byte,error){return nil,ErrClientLifecycle}

func newClientLifecycle(client clientLifecycleProvider,journal *runtime.StateJournal,identity ClientIdentity,kind string)(*clientLifecycle,error){
 if client==nil||journal==nil||(kind!=""&&kind!="service-account"){return nil,ErrClientLifecycle}
 identity.Ownership=maps.Clone(identity.Ownership);identity.LegacyAttributes=maps.Clone(identity.LegacyAttributes);identity.LegacyRenames=maps.Clone(identity.LegacyRenames)
 if err:=identity.validate();err!=nil{return nil,err}
 return &clientLifecycle{provider:client,journal:journal,identity:identity,kind:kind},nil
}

func(l *clientLifecycle)load(ctx context.Context)(runtime.StateSnapshot,clientLifecycleRecord,error){
 snapshot,err:=l.journal.Load(ctx);if err!=nil{return runtime.StateSnapshot{},clientLifecycleRecord{},err}
 if snapshot.Version()==0{return snapshot,clientLifecycleRecord{},nil}
 raw:=snapshot.Reveal();defer clear(raw)
 var record clientLifecycleRecord
 if decode(raw,&record)!=nil{return runtime.StateSnapshot{},clientLifecycleRecord{},ErrClientLifecycle}
 parser:=json.NewDecoder(bytes.NewReader(raw));parser.DisallowUnknownFields()
 if parser.Decode(&record)!=nil{return runtime.StateSnapshot{},clientLifecycleRecord{},ErrClientLifecycle}
 if err=record.validate(l.identity,l.kind);err!=nil{return runtime.StateSnapshot{},clientLifecycleRecord{},err}
 return snapshot,record,nil
}
func(l *clientLifecycle)save(ctx context.Context,prior runtime.StateSnapshot,record clientLifecycleRecord)(runtime.StateSnapshot,error){
 if err:=record.validate(l.identity,l.kind);err!=nil{return runtime.StateSnapshot{},err}
 raw,err:=json.Marshal(record);if err!=nil{return runtime.StateSnapshot{},ErrClientLifecycle};defer clear(raw)
 return l.journal.Save(ctx,prior,raw)
}

// Discovery is allowed only while there is no saved record. A current-format
// client without a record is not adopted through its public OAuth client ID.
func(l *clientLifecycle)discover(ctx context.Context)(clientLifecycleRecord,error){
 record:=clientLifecycleRecord{Version:1,Kind:l.kind,Phase:"allocated"}
 if len(l.identity.LegacyAttributes)!=0{
  binding,err:=l.provider.DiscoverOwnedClient(ctx,l.identity.ClientID,l.identity.LegacyAttributes)
  if err==nil{record.Binding=binding;record.Phase="legacy";return record,record.validate(l.identity,l.kind)}
  if !errors.Is(err,ErrNotFound){return clientLifecycleRecord{},err}
 }else{
  _,err:=l.provider.FindClient(ctx,l.identity.ClientID)
  if err==nil{return clientLifecycleRecord{},ErrOwnership}
  if !errors.Is(err,ErrNotFound){return clientLifecycleRecord{},err}
 }
 var id [16]byte;if _,err:=rand.Read(id[:]);err!=nil{return clientLifecycleRecord{},err}
 record.Binding=l.identity.binding(hex.EncodeToString(id[:]))
 return record,record.validate(l.identity,l.kind)
}

// prepare validates policy before effects and saves each recovery boundary.
func(l *clientLifecycle)prepare(ctx context.Context,validate func(clientLifecycleRecord)error,create func(context.Context,ClientBinding)error)(runtime.StateSnapshot,clientLifecycleRecord,error){
 failed:=func(err error)(runtime.StateSnapshot,clientLifecycleRecord,error){return runtime.StateSnapshot{},clientLifecycleRecord{},err}
 snapshot,record,err:=l.load(ctx);if err!=nil{return failed(err)}
 if record.Closed{return failed(ErrClientClosed)}
 if snapshot.Version()==0{record,err=l.discover(ctx);if err!=nil{return failed(err)}}
 if err=validate(record);err!=nil{return failed(err)}
 if snapshot.Version()==0{snapshot,err=l.save(ctx,snapshot,record);if err!=nil{return failed(err)}}
 if record.Phase=="legacy"{
  if err=l.provider.DisableClient(ctx,record.Binding);err!=nil{return failed(err)}
  plan,err:=l.provider.PrepareClientOwnershipMigration(ctx,record.Binding,l.identity.LegacyRenames);if err!=nil{return failed(err)}
  checkpoint,err:=plan.Checkpoint();if err!=nil{return failed(err)}
  record.Phase="migration";record.Migration=checkpoint.Reveal()
  snapshot,err=l.save(ctx,snapshot,record);if err!=nil{return failed(err)}
 }
 if record.Phase=="migration"{
  plan,err:=RestoreOwnershipMigration(record.Migration);if err!=nil{return failed(err)}
  next,err:=l.provider.MigrateClientOwnership(ctx,plan);if err!=nil{return failed(err)}
  record.Binding=next;record.Phase="bound";record.Migration=""
  snapshot,err=l.save(ctx,snapshot,record);if err!=nil{return failed(err)}
 }
 if record.Phase=="allocated"{
  _,err=l.provider.InspectClient(ctx,record.Binding)
  if errors.Is(err,ErrNotFound){err=create(ctx,record.Binding)}
  if err!=nil{return failed(err)}
  record.Phase="bound"
  snapshot,err=l.save(ctx,snapshot,record);if err!=nil{return failed(err)}
 }
 return snapshot,record,nil
}

// Close records irreversible intent before deletion. It never creates or enables
// a client. Repeated calls inspect the saved ID, including after confirmed absence.
// The journal adapter must require an authorized retained resource deletion.
func(l *clientLifecycle)Close(ctx context.Context)error{
 if l==nil||l.journal==nil||ctx==nil{return ErrClientLifecycle}
 snapshot,record,err:=l.load(ctx);if err!=nil{return err}
 if snapshot.Version()==0{record,err=l.discover(ctx);if err!=nil{return err}}
 if !record.Closed{
  record.Closed=true;snapshot,err=l.save(ctx,snapshot,record);if err!=nil{return err}
 }
 if record.Phase=="migration"{
  plan,err:=RestoreOwnershipMigration(record.Migration);if err!=nil{return err}
  binding,err:=l.provider.MigrateClientOwnership(ctx,plan)
  if errors.Is(err,ErrNotFound){return nil};if err!=nil{return err}
  record.Binding=binding;record.Phase="bound";record.Migration=""
  if _,err=l.save(ctx,snapshot,record);err!=nil{return err}
 }
 return l.provider.DeleteClient(ctx,record.Binding)
}
