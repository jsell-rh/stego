package {{.Package}}

import (
 "bytes"
 "context"
 "encoding/json"
 "errors"
 "net/http"
 "strconv"
 "strings"
)

// ServiceAccountPolicy sets the base client configuration. The application
// supplies ownership, roles, claims, and any shorter token lifetime limit.
// Ownership keys for this profile must start with stego.owner. so application
// metadata cannot become a Keycloak protocol setting.
// This policy does not prove that role, scope, or mapper policy is complete.
type ServiceAccountPolicy struct {
 DisplayName string
 AccessTokenLifetimeSeconds int
}

func serviceAccountConfiguration(b ClientBinding,p ServiceAccountPolicy)(ClientRepresentation,error){
 if err:=b.validate();err!=nil{return ClientRepresentation{},err}
 if (p.DisplayName!=""&&!textValue(p.DisplayName,255))||p.AccessTokenLifetimeSeconds<1||p.AccessTokenLifetimeSeconds>3600{return ClientRepresentation{},errors.New("invalid Keycloak service-account policy")}
 attributes:=map[string]string{
  "access.token.lifespan":strconv.Itoa(p.AccessTokenLifetimeSeconds),
  "client_credentials.use_refresh_token":"false",
  "oauth2.device.authorization.grant.enabled":"false",
  "oidc.ciba.grant.enabled":"false",
  "standard.token.exchange.enabled":"false",
  "oauth2.jwt.authorization.grant.enabled":"false",
  "external.token.enabled":"false",
 }
 for key,value:=range b.Attributes{
  if !strings.HasPrefix(key,"stego.owner.")||len(key)==len("stego.owner."){return ClientRepresentation{},errors.New("service-account ownership attributes require the stego.owner. prefix")}
  attributes[key]=value
 }
 return ClientRepresentation{ID:b.ID,ClientID:b.ClientID,Name:p.DisplayName,
  Protocol:"openid-connect",ClientAuthenticatorType:"client-secret",ServiceAccountsEnabled:true,
  RedirectURIs:[]string{},WebOrigins:[]string{},DefaultClientScopes:[]string{},OptionalClientScopes:[]string{},Attributes:attributes},nil
}

// CreateDisabledServiceAccount uses a stable ID from application state. Save
// that ID before this call so a later reconciliation can inspect an uncertain
// result. A conflict never causes adoption, deletion, or an automatic retry.
// Keycloak assigns the secret. This method does not accept or return a secret.
func(c *Client)CreateDisabledServiceAccount(ctx context.Context,b ClientBinding,p ServiceAccountPolicy)(ClientRepresentation,error){
 desired,err:=serviceAccountConfiguration(b,p);if err!=nil{return ClientRepresentation{},err}
 work,done,err:=c.begin(ctx);if err!=nil{return ClientRepresentation{},err};defer done()
 body,err:=json.Marshal(desired);if err!=nil{return ClientRepresentation{},ErrResponse}
 response,err:=c.admin(work,http.MethodPost,"/clients",body);if err!=nil{return ClientRepresentation{},err}
 if response.StatusCode!=http.StatusCreated{return ClientRepresentation{},statusError(response.StatusCode)}
 // Do not follow Location. Only the expected identity can confirm creation.
 return c.inspectDisabledServiceAccount(work,b,desired)
}

// InspectDisabledServiceAccount checks the base client policy. It does not
// permit enablement or replace checks of effective roles and token claims.
func(c *Client)InspectDisabledServiceAccount(ctx context.Context,b ClientBinding,p ServiceAccountPolicy)(ClientRepresentation,error){
 desired,err:=serviceAccountConfiguration(b,p);if err!=nil{return ClientRepresentation{},err}
 work,done,err:=c.begin(ctx);if err!=nil{return ClientRepresentation{},err};defer done()
 return c.inspectDisabledServiceAccount(work,b,desired)
}
func(c *Client)inspectDisabledServiceAccount(ctx context.Context,b ClientBinding,desired ClientRepresentation)(ClientRepresentation,error){
 value,raw,err:=c.boundClient(ctx,b);if err!=nil{return ClientRepresentation{},err}
 if !serviceAccountConfigurationMatches(value,raw,desired){return ClientRepresentation{},errors.New("Keycloak disabled service-account configuration is not confirmed")}
 return value,nil
}

// ConfigureDisabledServiceAccount repairs base settings only after ownership
// and explicit disablement are confirmed. It leaves roles, scopes, mappers,
// and credentials in place. Scope drift can still cause the final check to
// fail; the caller must repair that drift before the client can be enabled.
func(c *Client)ConfigureDisabledServiceAccount(ctx context.Context,b ClientBinding,p ServiceAccountPolicy)error{
 desired,err:=serviceAccountConfiguration(b,p);if err!=nil{return err}
 work,done,err:=c.begin(ctx);if err!=nil{return err};defer done()
 value,raw,err:=c.boundClient(work,b);if err!=nil{return err}
 var fields map[string]json.RawMessage
 if json.Unmarshal(raw,&fields)!=nil||string(bytes.TrimSpace(fields["enabled"]))!="false"{return errors.New("Keycloak service-account configuration requires a disabled client")}
 if serviceAccountConfigurationMatches(value,raw,desired){return nil}
 body,err:=json.Marshal(desired);if err!=nil{return ErrResponse}
 // Scope assignments have separate endpoints. Do not imply that a client
 // update can remove those assignments.
 var update map[string]json.RawMessage
 if json.Unmarshal(body,&update)!=nil{return ErrResponse}
 delete(update,"defaultClientScopes");delete(update,"optionalClientScopes")
 // An empty display name must clear an old name, not omit the update.
 update["name"],err=json.Marshal(desired.Name);if err!=nil{return ErrResponse}
 body,err=json.Marshal(update);if err!=nil{return ErrResponse}
 response,err:=c.admin(work,http.MethodPut,"/clients/"+b.ID,body);if err!=nil{return err}
 if response.StatusCode!=http.StatusNoContent{return statusError(response.StatusCode)}
 _,err=c.inspectDisabledServiceAccount(work,b,desired);return err
}

func serviceAccountConfigurationMatches(value ClientRepresentation,raw []byte,desired ClientRepresentation)bool{
 if value.ID!=desired.ID||value.ClientID!=desired.ClientID||value.Name!=desired.Name||value.Protocol!="openid-connect"||value.ClientAuthenticatorType!="client-secret"{return false}
 // Full representations contain these booleans even when false. A missing
 // field must not become an implicit false through Go's zero value.
 var fields map[string]json.RawMessage
 if json.Unmarshal(raw,&fields)!=nil{return false}
 for key,expected:=range map[string]string{"enabled":"false","publicClient":"false","bearerOnly":"false","consentRequired":"false","serviceAccountsEnabled":"true","standardFlowEnabled":"false","implicitFlowEnabled":"false","directAccessGrantsEnabled":"false","fullScopeAllowed":"false"}{
  if string(bytes.TrimSpace(fields[key]))!=expected{return false}
 }
 // Keycloak omits this field when no authorization resource server exists.
 if flag,exists:=fields["authorizationServicesEnabled"];exists&&string(bytes.TrimSpace(flag))!="false"{return false}
 if value.RedirectURIs==nil||len(value.RedirectURIs)!=0||value.WebOrigins==nil||len(value.WebOrigins)!=0||value.OptionalClientScopes==nil||len(value.OptionalClientScopes)!=0{return false}
 // Keycloak can attach its built-in service_account scope at creation.
 // Its effective mappings still require the separate role and claim checks.
 if value.DefaultClientScopes==nil||!(len(value.DefaultClientScopes)==0||(len(value.DefaultClientScopes)==1&&value.DefaultClientScopes[0]=="service_account")){return false}
 for key,expected:=range desired.Attributes{if value.Attributes[key]!=expected{return false}}
 return true
}
