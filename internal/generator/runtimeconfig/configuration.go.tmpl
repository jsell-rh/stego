func Load{{.Name}}()({{.Name}},error){return Read{{.Name}}(os.LookupEnv)}

// Read{{.Name}} reads each field once. A failure returns no partial configuration.
// The lookup must be trusted and return promptly. It is not a snapshot of os.Environ.
func Read{{.Name}}(lookup func(string)(string,bool))({{.Name}},error){
 if lookup==nil{return {{.Name}}{},&Error{group:{{quote .Name}},reason:"lookup"}}
 var result {{.Name}}
 {{range .Fields}}{
 raw,present:=lookup({{quote .Env}})
 {{if .Default}}if !present {raw={{quote (value .Default)}};present=true}{{end}}
 if !present{return {{$group.Name}}{},&Error{group:{{quote $group.Name}},field:{{quote .Name}},reason:"missing"}}
 value,ok:={{reader .}}
 if !ok{return {{$group.Name}}{},&Error{group:{{quote $group.Name}},field:{{quote .Name}},reason:"invalid"}}
 result.{{.Name}}=value
 }
 {{end}}
 return result,nil
}
