var ErrConfiguration = errors.New("invalid runtime configuration")

// Error identifies a declared field and a fixed reason. It retains no input.
type Error struct { group, field, reason string }
func(e *Error) Error() string { return "invalid runtime configuration: " + e.group + "." + e.field + " (" + e.reason + ")" }
func(e *Error) Unwrap() error { return ErrConfiguration }
func(e *Error) Group() string { return e.group }
func(e *Error) Field() string { return e.field }
func(e *Error) Reason() string { return e.reason }

func boundedText(raw string) bool {
 return len(raw)<=4096 && utf8.ValidString(raw) && strings.IndexFunc(raw, unicode.IsControl)==-1
}
func readString(raw string, minimum, maximum int)(string,bool){
 return raw, boundedText(raw) && len(raw)>=minimum && len(raw)<=maximum
}
func readInteger(raw string, minimum, maximum int64)(int64,bool){
 if len(raw)>20{return 0,false}
 value,err:=strconv.ParseInt(raw,10,64)
 return value,err==nil && strconv.FormatInt(value,10)==raw && value>=minimum && value<=maximum
}
func readDuration(raw string, minimum, maximum time.Duration)(time.Duration,bool){
 if len(raw)>64{return 0,false}
 value,err:=time.ParseDuration(raw)
 return value,err==nil && value>=minimum && value<=maximum
}
func readBoolean(raw string)(bool,bool){return raw=="true",raw=="true"||raw=="false"}

