  patch:=kube.Object{"metadata":kube.Object{"uid":kube.String(current,"metadata","uid"),"resourceVersion":kube.String(current,"metadata","resourceVersion"),"annotations":kube.Object{networkHashAnnotation:networkHash(expectedJSON)}},"spec":patchSpec}
  if _,_,err=a.client.Request(ctx,http.MethodPatch,collection+"/stego-allocation",patch);err!=nil{return err}
  return ErrPending
 }

 return nil
}

// Delete removes cluster bindings first. It returns true only after all owned
// resources are absent. The caller must keep deleted application records until
// this method returns true. An absent namespace does not skip binding cleanup.
func (a *Allocator) Delete(ctx context.Context, profileName, name, ownerID string) (bool, error) {
 _, owner, err := a.request(profileName, name, ownerID); if err != nil { return false, err }
 // Read the namespace first so that a foreign owner cannot trigger any write.
 current, code, err := a.client.Request(ctx, http.MethodGet, "/api/v1/namespaces/"+name, nil)
 if err != nil { return false, err }
 if code != http.StatusNotFound && !owner.Matches(current) { return false, errors.New("namespace has a different owner") }
 ready := true
 collection := "/apis/rbac.authorization.k8s.io/v1/clusterrolebindings"
 bindings,err:=a.bindings(ctx,collection,name,owner);if err!=nil{return false,err}
 for _,old:=range bindings{
  err:=a.removeBinding(ctx,collection,old)
  if errors.Is(err,ErrPending){ready=false}else if err!=nil{return false,err}
 }
 if !ready { return false, nil }
 return a.client.DeleteOwned(ctx, "/api/v1/namespaces/"+name, owner)
}

// sealIdentity copies only declared public fields from an immutable record.
// Values on the Namespace can be set once. Loss of the source record cannot
// remove those values. Consumers must observe the seal before they use keys.
func (a *Allocator) sealIdentity(ctx context.Context,p profile,name string,owner kube.Owner)error{
 if p.IdentityConfigMap==""{return nil}
 record,code,err:=a.client.Request(ctx,http.MethodGet,"/api/v1/namespaces/"+name+"/configmaps/"+p.IdentityConfigMap,nil)
 if err!=nil{return err};if code==404{return nil}
 if !owner.Matches(record)||record["immutable"]!=true||kube.String(record,"metadata","uid")==""||kube.String(record,"metadata","resourceVersion")==""||kube.String(record,"metadata","deletionTimestamp")!=""{return errors.New("namespace identity record is not owned and immutable")}
 fields:=map[string]kube.Object{"labels":{},"annotations":{}}
 for _,group:=range []struct{name string;fields []identityField}{ {"labels",p.IdentityLabels},{"annotations",p.IdentityAnnotations}}{
  for _,field:=range group.fields{
   value:=kube.String(record,"data",field.Field)
   if len(value)==0||len(value)>256{return errors.New("invalid namespace identity value")}
   if group.name=="labels"&&!ownerValue.MatchString(value){return errors.New("invalid namespace identity label")}
   for _,c:=range value{if c<32||c>126{return errors.New("namespace identity requires printable ASCII")}}
   fields[group.name][field.Key]=value
  }
 }
 current,code,err:=a.client.Request(ctx,http.MethodGet,"/api/v1/namespaces/"+name,nil)
 if err!=nil{return err};if code==404{return ErrPending}
 if !owner.Matches(current)||kube.String(current,"metadata","uid")==""||kube.String(current,"metadata","resourceVersion")==""||kube.String(current,"metadata","deletionTimestamp")!=""{return errors.New("namespace identity target is not owned and active")}
 changes:=kube.Object{"uid":kube.String(current,"metadata","uid"),"resourceVersion":kube.String(current,"metadata","resourceVersion")}
 missing:=false
 for group,values:=range fields{if len(values)==0{continue};for key,value:=range values{
  old:=kube.Nested(current,"metadata",group,key)
  if old!=nil&&old!=value{return errors.New("namespace identity differs from its seal")}
  missing=missing||old==nil
 };changes[group]=values}
 if !missing{return nil}
 _,_,err=a.client.Request(ctx,http.MethodPatch,"/api/v1/namespaces/"+name,kube.Object{"metadata":changes})
 return err
}

// RequireNamespace checks allocation identity without creating or changing it.
// A resource worker needs read-only Namespace access. An isolated profile also
// needs get access to the named stego-allocation NetworkPolicy and list access
// to all NetworkPolicies in that namespace.
func (a *Allocator) RequireNamespace(ctx context.Context,profileName,name,ownerID string)error{
 if _,err:=a.NamespaceUID(ctx,profileName,name,ownerID);err!=nil{return err}
 p,owner,err:=a.request(profileName,name,ownerID);if err!=nil{return err}
 if p.NetworkIsolation{return a.requireNetwork(ctx,p,name,owner,false)};return nil
}
// NamespaceUID returns the identity of the verified, live allocation. It does
// not prove that every role binding is ready or that a worker has Pod access.
func (a *Allocator) NamespaceUID(ctx context.Context,profileName,name,ownerID string)(string,error){
 p,owner,err:=a.request(profileName,name,ownerID);if err!=nil{return "",err}
 current,code,err:=a.client.Request(ctx,http.MethodGet,"/api/v1/namespaces/"+name,nil)
 if err!=nil{return "",err};if code==404{return "",ErrPending}
 if !owner.Matches(current)||kube.String(current,"metadata","uid")==""||kube.String(current,"metadata","resourceVersion")==""{return "",errors.New("namespace allocation has a different identity")}
 if kube.String(current,"metadata","deletionTimestamp")!=""{return "",ErrPending}
 if p.PodSecurity=="isolated-runtime"&&kube.String(current,"metadata","labels","pod-security.kubernetes.io/enforce")!=podSecurityLevel(p){return "",errors.New("namespace Pod security differs from its allocation")}
 if err=a.requireServiceAccountNames(p,current,ownerID);err!=nil{return "",err};return kube.String(current,"metadata","uid"),nil
}

// NamespaceGone observes cleanup without performing it. A foreign namespace
// with the same name is an error, not evidence that cleanup has completed.
func (a *Allocator) NamespaceGone(ctx context.Context,profileName,name,ownerID string)(bool,error){
 _,owner,err:=a.request(profileName,name,ownerID);if err!=nil{return false,err}
 current,code,err:=a.client.Request(ctx,http.MethodGet,"/api/v1/namespaces/"+name,nil)
 if err!=nil{return false,err};if code==404{return true,nil}
 if !owner.Matches(current)||kube.String(current,"metadata","uid")==""||kube.String(current,"metadata","resourceVersion")==""{return false,errors.New("namespace allocation has a different identity")}
 return false,nil
}
