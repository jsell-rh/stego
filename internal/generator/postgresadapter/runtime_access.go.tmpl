package {{.Package}}

import (
	"context"
	"database/sql"
	"errors"
	"strings"

	"github.com/jsell-rh/stego/registry/runtime/tenant"
)

// TenantConfig gives the connection configuration of the runtime library's connectors, tenant.Open and
// tenant.OpenOwner, for dsn: the configuration that OpenDatabase builds, with its verified TLS policy and the
// loopback test mode of STEGO_DATABASE_ALLOW_INSECURE_LOOPBACK, and the pool bounds of the DATABASE_POOL settings
// (ST-SUP-RC01-OC41, ST-SUP-RP04-LC09).
func TenantConfig(dsn string) (tenant.Config, error) {
	config, err := databaseConfiguration(dsn)
	if err != nil {
		return tenant.Config{}, err
	}
	insecure, err := databaseLoopbackTestMode()
	if err != nil {
		return tenant.Config{}, err
	}
	settings, err := readDatabasePoolSettings()
	if err != nil {
		return tenant.Config{}, err
	}
	return tenant.Config{Conn: config, InsecureLoopback: insecure, Pool: tenant.PoolBounds{MaxOpen: settings.open,
		MaxIdle: settings.idle, MaxLifetime: settings.lifetime, MaxIdleTime: settings.idleTime}}, nil
}

// ErrForeignTables is the refusal of a database that holds tables which this release did not make.
var ErrForeignTables = errors.New("the database holds tables of the declaration that its ledger does not record, or a ledger that is not the history of this release; the migration job writes nothing (ST-SUP-Q91)")

// declaredTables are the tables of the entities of the declaration.
var declaredTables = []string{ {{- range .Tables}}{{printf "%q" .}}, {{end -}} }

// CheckLedger reads the database and refuses it, with ErrForeignTables, when its ledger is not a prefix of the
// migrations of this release, or when it has no ledger and holds a table of the declaration. It writes nothing; the
// migration job calls it before its first write (ST-SUP-RC01-OC41).
func CheckLedger(ctx context.Context, db Database) error {
	if ctx == nil || db == nil {
		return ErrMigrationLedger
	}
	return inTransaction(ctx, db, &sql.TxOptions{ReadOnly: true}, func(tx *sql.Tx) error {
		var ledger bool
		if err := tx.QueryRowContext(ctx, "SELECT pg_catalog.to_regclass('stego_schema.migrations') IS NOT NULL").Scan(&ledger); err != nil {
			return err
		}
		if !ledger {
			var found int64
			if err := tx.QueryRowContext(ctx, "SELECT count(*) FROM pg_catalog.pg_tables WHERE schemaname = 'public' AND tablename = ANY(pg_catalog.string_to_array($1, ','))",
				strings.Join(declaredTables, ",")).Scan(&found); err != nil {
				return err
			}
			if found > 0 {
				return ErrForeignTables
			}
			return nil
		}
		applied, err := appliedMigrations(ctx, tx)
		if err != nil {
			return err
		}
		registered := orderedMigrations()
		if len(applied) > len(registered) {
			return ErrForeignTables
		}
		for i, row := range applied {
			if row.Name != registered[i].Name || row.Digest != registered[i].Digest {
				return ErrForeignTables
			}
		}
		return nil
	})
}
