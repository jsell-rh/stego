// The declaration of the service.
const (
	// Service is the name of the service, which its audit rows and its telemetry carry.
	Service = {{printf "%q" .Service}}
	// DeclarationVersion is the SHA-256 of the declaration, which each audit row carries.
	DeclarationVersion = {{printf "%q" .DeclarationVersion}}
	// subjectType is the subject type of the schema that a verified identity maps to.
	subjectType = {{printf "%q" .SubjectType}}
	// tenantClaim is the dotted path of the claim that names the caller's tenant.
	tenantClaim = {{printf "%q" .TenantClaim}}
	// problemType and problemCode are the problem base and the problem code prefix of a refused credential.
	problemType = {{printf "%q" .ProblemType}}
	problemCode = {{printf "%q" .ProblemCode}}
)

// The settings of the verifier that the declaration states, through the settings of its auth provider; an empty one
// is not stated. A stated setting wins: the environment may only match it.
const (
	declaredIssuer    = {{printf "%q" .Issuer}}
	declaredAudience  = {{printf "%q" .Audience}}
	declaredHeader    = {{printf "%q" .Header}}
	declaredKeyFile   = {{printf "%q" .KeyFile}}
	declaredRoleClaim = {{printf "%q" .RoleClaim}}
)

// migrationTimeout is the longest time that the migration job runs.
const migrationTimeout = 10 * time.Minute

// The roles of the database. RuntimeRole and OwnerRole are the tenancy component's. WorkerRole is the role that the
// outbox worker connects as and RelayRole the login role of the authorization relay; the database administrator
// creates both, with no login of the runtime role, before the first migration job.
const (
	RuntimeRole = svctenancy.RuntimeRole
	OwnerRole   = svctenancy.OwnerRole
	WorkerRole  = {{printf "%q" .WorkerRole}}
	RelayRole   = {{printf "%q" .RelayRole}}
)

// The settings of the deployment, which the process environment gives.
const (
	// DatabaseURLSetting is the connection string of the runtime role, and DatabaseURLFileSetting the absolute path of
	// a file that holds it: one of the two.
	DatabaseURLSetting     = "DATABASE_URL"
	DatabaseURLFileSetting = "DATABASE_URL_FILE"
	// MigrationDatabaseURLSetting is the connection string of the migration job: a login that is the owner role or
	// may SET ROLE to it, and never the runtime role. MigrationDatabaseURLFileSetting is a file that holds it.
	MigrationDatabaseURLSetting     = "STEGO_MIGRATION_DATABASE_URL"
	MigrationDatabaseURLFileSetting = "STEGO_MIGRATION_DATABASE_URL_FILE"
	// IssuerSetting and AudienceSetting are the issuer and the audience that each bearer token must name.
	IssuerSetting   = "STEGO_AUTHN_ISSUER"
	AudienceSetting = "STEGO_AUTHN_AUDIENCE"
	// KeysURLSetting and KeysFileSetting name the key document of the issuer: one of the two.
	KeysURLSetting  = "STEGO_AUTHN_KEYS_URL"
	KeysFileSetting = "STEGO_AUTHN_KEYS_FILE"
	// SpiceDBEndpointSetting is the address of SpiceDB, and SpiceDBKeyFileSetting the file of its preshared key.
	SpiceDBEndpointSetting = "STEGO_SPICEDB_ENDPOINT"
	SpiceDBKeyFileSetting  = "STEGO_SPICEDB_KEY_FILE"
	// SpiceDBInsecureLoopbackSetting set to 1 lets the connection to a loopback SpiceDB address go without TLS, for
	// a local test only; every other address needs verified TLS.
	SpiceDBInsecureLoopbackSetting = "STEGO_SPICEDB_INSECURE_LOOPBACK"
	// CursorKeyFileSetting is the file of the key of the list cursors: at least query.MinCursorKey bytes, the same
	// in every replica.
	CursorKeyFileSetting = "STEGO_QUERY_CURSOR_KEY_FILE"
	// VersionSetting is the version of the release, which each audit row carries.
	VersionSetting = "STEGO_SERVICE_VERSION"
)

// grants are the privileges of the runtime role on the objects of the database access contract and on the
// idempotency keys, each without its grantee, which the migration job grants after it made the objects.
var grants = []string{
{{- range .Grants}}
	{{printf "%q" .}},
{{- end}}
}

// Runtime holds the runtime library objects of the running service.
type Runtime struct {
	pool, auditDB *sql.DB
	keys          *authn.KeySet
	verifier      *authn.Verifier
	spice         *grpc.ClientConn
	telemetry     *otel.Runtime
	probes        *probe.Runtime
	authz         *stegoauthz.Runtime
	writer        *audit.Writer
	commands      *command.Runtime
	collections   *command.Runtime
	queries       *query.Runtime
	routes        *http.ServeMux
}

// NewService builds the runtime of the service from the settings of the deployment and the declaration. It opens
// the main pool and the audit pool of the runtime role through tenant.Open with the PostgreSQL adapter's verified
// TLS configuration, connects to SpiceDB, and makes the command and query handlers, which Routes serves.
func NewService(ctx context.Context) (rt *Runtime, err error) {
	rt = &Runtime{}
	defer func() {
		if err != nil {
			rt.Close()
			rt = nil
		}
	}()
	dsn, err := databaseURL(DatabaseURLSetting, DatabaseURLFileSetting)
	if err != nil {
		return nil, err
	}
	pools, err := svcstorage.TenantConfig(dsn)
	if err != nil {
		return nil, err
	}
	if rt.pool, err = tenant.Open(ctx, pools); err != nil {
		return nil, err
	}
	if rt.auditDB, err = tenant.Open(ctx, pools); err != nil {
		return nil, err
	}
	queue, err := svcoutbox.NewQueue(rt.pool, nil)
	if err != nil {
		return nil, err
	}
	auditQueue, err := svcoutbox.AuditQueue(queue)
	if err != nil {
		return nil, err
	}
	if rt.writer, err = audit.NewWriter(auditQueue, nil); err != nil {
		return nil, err
	}
	if rt.spice, err = spiceDB(); err != nil {
		return nil, err
	}
	provider, err := stegoauthz.NewSpiceDB(rt.spice)
	if err != nil {
		return nil, err
	}
	if rt.authz, err = svcauthz.NewRuntime(rt.pool, provider, queue, nil); err != nil {
		return nil, err
	}
	if rt.telemetry, err = otel.New(Service, probe.SpanNames()...); err != nil {
		return nil, err
	}
	if rt.probes, err = probe.Start(rt.telemetry, nil); err != nil {
		return nil, err
	}
	if rt.keys, err = keySet(ctx); err != nil {
		return nil, err
	}
	issuer, err := declared(IssuerSetting, declaredIssuer)
	if err != nil {
		return nil, err
	}
	audience, err := declared(AudienceSetting, declaredAudience)
	if err != nil {
		return nil, err
	}
	if rt.verifier, err = authn.New(authn.Settings{Issuer: issuer, Audience: audience, TenantClaim: tenantClaim,
		Header: declaredHeader, RoleClaim: declaredRoleClaim, ProblemType: problemType, ProblemCode: problemCode,
		Keys: rt.keys}); err != nil {
		return nil, err
	}
	rt.routes = http.NewServeMux()
{{- if or .Commands .API}}
	config := command.Config{DB: rt.pool, AuditDB: rt.auditDB, Authz: rt.authz, Audit: rt.writer, AuditSettings: svcaudit.Settings,
		Outbox: queue, Probes: rt.probes, Service: Service, ServiceVersion: os.Getenv(VersionSetting), DeclarationVersion: DeclarationVersion}
{{- end}}
{{- if .Commands}}
	config.Entities = commandhandlers.Entities()
	if rt.commands, err = command.New(ctx, config); err != nil {
		return nil, err
	}
	if err = commandhandlers.Register(rt.routes, rt.commands, commandhandlers.BoundFills(), commandhandlers.Options{Retention: retention}); err != nil {
		return nil, err
	}
{{- end}}
{{- if .API}}
	config.Entities = api.Entities()
	if rt.collections, err = command.New(ctx, config); err != nil {
		return nil, err
	}
{{- end}}
	cursorKey, err := cursorKey()
	if err != nil {
		return nil, err
	}
	if rt.queries, err = query.New(query.Config{DB: rt.pool, AuditDB: rt.auditDB, Audit: rt.writer, AuditSettings: svcaudit.Settings,
		Authz: rt.authz, Service: Service, CursorKey: cursorKey}); err != nil {
		return nil, err
	}
{{- if .Queries}}
	queries, err := queryserve.New(queryserve.Config{Runtime: rt.queries, Verifier: rt.verifier, Probes: rt.probes, SubjectType: subjectType})
	if err != nil {
		return nil, err
	}
	queries.Routes(rt.routes)
{{- end}}
	return rt, nil
}

// retention is how long a completed idempotency key is kept: the declared retention, or zero for the runtime's
// default.
const retention = {{if .Idempotency}}svcidempotency.Retention{{else}}0{{end}}

// Middleware verifies the bearer token of each request before next; a request whose token the verifier refuses is
// answered 401 and reaches no handler.
func (rt *Runtime) Middleware(next http.Handler) http.Handler { return rt.verifier.Middleware(next) }

// Routes serves the declared commands and queries, each at its route.
func (rt *Runtime) Routes() http.Handler { return rt.routes }
{{- if .API}}

// CollectionRuntime gives the Runtime of the collection handlers: their own command runtime, the query runtime and
// the probes.
func (rt *Runtime) CollectionRuntime() *api.Runtime {
	return &api.Runtime{Commands: rt.collections, Queries: rt.queries, Probes: rt.probes, Retention: retention}
}
{{- end}}

// Close releases what NewService opened.
func (rt *Runtime) Close() error {
	var errs []error
	if rt.probes != nil {
		errs = append(errs, rt.probes.Close(context.Background()))
	}
	if rt.telemetry != nil {
		errs = append(errs, rt.telemetry.Shutdown(context.Background()))
	}
	if rt.verifier != nil {
		rt.verifier.Stop()
	}
	if rt.keys != nil {
		rt.keys.Stop()
	}
	if rt.spice != nil {
		errs = append(errs, rt.spice.Close())
	}
	for _, db := range []*sql.DB{rt.auditDB, rt.pool} {
		if db != nil {
			errs = append(errs, db.Close())
		}
	}
	return errors.Join(errs...)
}

// Migrate is the migration job of the service (tenant.MigrationJob), with a time limit. It opens the database with
// STEGO_MIGRATION_DATABASE_URL through tenant.OpenOwner, with the adapter's verified TLS configuration, and runs
// every step on one connection, each step as the owner role. It first reads the database, and refuses one whose
// tables this release did not make, such as the tables of a release on the GORM store, writing nothing. It then
// writes the authorization schema to SpiceDB, which refuses, and writes nothing, a schema that removes a definition
// or a relation that has relationships (ST-SUP-RC29-OC23), so a refused schema leaves the database as it was. Then,
// in this order: the ledger of the PostgreSQL adapter, which creates the tables of the declaration and their
// row-level security; the outbox queue, the audit tables, the idempotency keys and the authorization tables of the
// runtime library, each in one transaction; the grants of the runtime role; and the audit partitions of this month
// and the next. Each step runs again on a database that it made, so the job runs on every release.
func Migrate(parent context.Context) error {
	ctx, cancel := context.WithTimeout(parent, migrationTimeout)
	defer cancel()
	dsn, err := databaseURL(MigrationDatabaseURLSetting, MigrationDatabaseURLFileSetting)
	if err != nil {
		return failed("settings", err)
	}
	config, err := svcstorage.TenantConfig(dsn)
	if err != nil {
		return failed("settings", err)
	}
	db, err := tenant.OpenOwner(ctx, tenant.MigrationJob, config)
	if err != nil {
		return failed("open", err)
	}
	defer db.Close()
	conn, err := db.Conn(ctx)
	if err != nil {
		return failed("open", err)
	}
	defer conn.Close()
	asOwner := "SET ROLE " + quote(OwnerRole)
	if _, err := conn.ExecContext(ctx, asOwner); err != nil {
		return failed("owner_role", err)
	}
	ledger, err := gorm.Open(postgres.New(postgres.Config{Conn: conn}), &gorm.Config{Logger: gormlogger.Discard, DisableAutomaticPing: true})
	if err != nil {
		return failed("open", err)
	}
	if err := svcstorage.CheckLedger(ledger.WithContext(ctx)); err != nil {
		return failed("ledger_check", err)
	}
	queueText, err := svcoutbox.Migration(RuntimeRole, WorkerRole)
	if err != nil {
		return failed("settings", err)
	}
	auditText, err := svcaudit.Migration(RuntimeRole)
	if err != nil {
		return failed("settings", err)
	}
	authzText, err := svcauthz.Migration(RuntimeRole, RelayRole, WorkerRole)
	if err != nil {
		return failed("settings", err)
	}
	spice, err := spiceDB()
	if err != nil {
		return failed("authorization_schema", err)
	}
	defer spice.Close()
	if err := svcauthz.WriteSchema(ctx, spice); err != nil {
		return failed("authorization_schema", err)
	}
	if _, err := conn.ExecContext(ctx, asOwner); err != nil {
		return failed("owner_role", err)
	}
	if err := svcstorage.Migrate(ledger.WithContext(ctx)); err != nil {
		return failed("tables", err)
	}
	steps := []struct{ name, text string }{
		{"outbox_queue", queueText},
		{"audit_tables", auditText},
		{"idempotency_keys", idempotency.Migration},
		{"authorization_tables", authzText},
		{"runtime_grants", granted()},
	}
	for _, step := range steps {
		if err := ownerStep(ctx, conn, func(tx *sql.Tx) error {
			_, err := tx.ExecContext(ctx, step.text)
			return err
		}); err != nil {
			return failed(step.name, err)
		}
	}
	if err := maintainAudit(ctx, conn); err != nil {
		return failed("audit_partitions", err)
	}
	return nil
}

// stepError is the failure of one step of the migration job.
type stepError struct {
	step string
	err  error
}

func (e *stepError) Error() string { return "migrate: " + e.step + ": " + e.err.Error() }
func (e *stepError) Unwrap() error { return e.err }

// failed gives the failure of the step of the migration job.
func failed(step string, err error) error { return &stepError{step: step, err: err} }

// MigrationStage gives the stage of a failure of Migrate, such as migrate.ledger_check, which names the step and no
// error text, for the failure record of the process.
func MigrationStage(err error) string {
	var step *stepError
	if errors.As(err, &step) {
		return "migrate." + step.step
	}
	return "migrate"
}

// granted gives the statements of grants to the runtime role.
func granted() string {
	var text strings.Builder
	for _, grant := range grants {
		text.WriteString(grant + " TO " + quote(RuntimeRole) + ";\n")
	}
	return text.String()
}

// ownerStep runs one step of the migration job in one transaction on conn, as the owner role from its start: a step
// can reset the role, as the outbox migration does after it made the relay functions.
func ownerStep(ctx context.Context, conn *sql.Conn, step func(*sql.Tx) error) error {
	tx, err := conn.BeginTx(ctx, nil)
	if err != nil {
		return err
	}
	defer func() { _ = tx.Rollback() }()
	if _, err := tx.ExecContext(ctx, "SET LOCAL ROLE "+quote(OwnerRole)); err != nil {
		return err
	}
	if err := step(tx); err != nil {
		return err
	}
	return tx.Commit()
}

// maintainAudit runs the audit partition maintenance until it has no step left, so the partitions of this month
// and the next exist before the service writes an audit row.
func maintainAudit(ctx context.Context, conn *sql.Conn) error {
	for range 64 {
		var more bool
		if err := ownerStep(ctx, conn, func(tx *sql.Tx) error {
			return tx.QueryRowContext(ctx, "SELECT step_left FROM "+audit.MaintainFunction+"()").Scan(&more)
		}); err != nil {
			return err
		}
		if !more {
			return nil
		}
	}
	return errors.New("the audit partition maintenance did not finish")
}

// spiceDB connects to the SpiceDB of SpiceDBEndpointSetting with the preshared key of SpiceDBKeyFileSetting, over
// verified TLS, or without TLS to a loopback address when SpiceDBInsecureLoopbackSetting is 1.
func spiceDB() (*grpc.ClientConn, error) {
	endpoint, err := required(SpiceDBEndpointSetting)
	if err != nil {
		return nil, err
	}
	keyFile, err := required(SpiceDBKeyFileSetting)
	if err != nil {
		return nil, err
	}
	key, err := os.ReadFile(keyFile)
	if err != nil {
		return nil, fmt.Errorf("%s: %w", SpiceDBKeyFileSetting, err)
	}
	token := strings.TrimSpace(string(key))
	if token == "" {
		return nil, fmt.Errorf("%s names an empty key", SpiceDBKeyFileSetting)
	}
	transport := credentials.NewTLS(&tls.Config{MinVersion: tls.VersionTLS12})
	plaintext := false
	switch os.Getenv(SpiceDBInsecureLoopbackSetting) {
	case "", "0":
	case "1":
		host, _, err := net.SplitHostPort(endpoint)
		if ip := net.ParseIP(host); err != nil || ip == nil || !ip.IsLoopback() {
			return nil, fmt.Errorf("%s allows no TLS only for a loopback address, not %q", SpiceDBInsecureLoopbackSetting, endpoint)
		}
		transport, plaintext = insecure.NewCredentials(), true
	default:
		return nil, fmt.Errorf("%s must be 0 or 1", SpiceDBInsecureLoopbackSetting)
	}
	return grpc.NewClient(endpoint, grpc.WithTransportCredentials(transport), grpc.WithPerRPCCredentials(presharedKey{token: token, plaintext: plaintext}))
}

// presharedKey sends the preshared key of SpiceDB on each call.
type presharedKey struct {
	token     string
	plaintext bool
}

func (k presharedKey) GetRequestMetadata(context.Context, ...string) (map[string]string, error) {
	return map[string]string{"authorization": "Bearer " + k.token}, nil
}

func (k presharedKey) RequireTransportSecurity() bool { return !k.plaintext }

// keySet loads the key of the issuer from the public key file that the declaration states, or the key document of
// KeysURLSetting or KeysFileSetting.
func keySet(ctx context.Context) (*authn.KeySet, error) {
	if declaredKeyFile != "" {
		if os.Getenv(KeysURLSetting) != "" || os.Getenv(KeysFileSetting) != "" {
			return nil, fmt.Errorf("the declaration states the public key file %q, so the settings %s and %s must not be set", declaredKeyFile, KeysURLSetting, KeysFileSetting)
		}
		return authn.NewKeySet(ctx, authn.KeySource{PEMFile: declaredKeyFile})
	}
	return authn.NewKeySet(ctx, authn.KeySource{URL: os.Getenv(KeysURLSetting), File: os.Getenv(KeysFileSetting)})
}

// declared gives the value that the declaration states, or the setting name when it states none. A setting that
// is set to another value than the stated one is refused: the declaration wins.
func declared(name, stated string) (string, error) {
	value := os.Getenv(name)
	if stated == "" {
		if value == "" {
			return "", fmt.Errorf("the setting %s is not set, and the declaration states no value for it", name)
		}
		return value, nil
	}
	if value != "" && value != stated {
		return "", fmt.Errorf("the setting %s is %q, and the declaration states %q: the declared value wins, and the setting may only match it", name, value, stated)
	}
	return stated, nil
}

// databaseURL gives the connection string of the setting name, or of the file that the setting fileName names: one
// of the two, as the service's main reads DATABASE_URL and DATABASE_URL_FILE. The file is a regular file of at most
// 64 KiB that no group or other may write, at an absolute path.
func databaseURL(name, fileName string) (string, error) {
	value, file := os.Getenv(name), os.Getenv(fileName)
	if (value == "") == (file == "") {
		return "", fmt.Errorf("set exactly one of the settings %s and %s", name, fileName)
	}
	if file == "" {
		return value, nil
	}
	invalid := fmt.Errorf("the setting %s names no readable connection string file", fileName)
	if !filepath.IsAbs(file) {
		return "", invalid
	}
	f, err := os.OpenFile(file, os.O_RDONLY|syscall.O_NONBLOCK, 0)
	if err != nil {
		return "", invalid
	}
	defer f.Close()
	info, err := f.Stat()
	if err != nil || !info.Mode().IsRegular() || info.Size() > 65536 || info.Mode().Perm()&0o137 != 0 {
		return "", invalid
	}
	data, err := io.ReadAll(io.LimitReader(f, 65537))
	if err != nil || len(data) > 65536 {
		return "", invalid
	}
	value = strings.TrimSuffix(strings.TrimSuffix(string(data), "\n"), "\r")
	if value == "" || strings.ContainsAny(value, "\x00\r\n") {
		return "", invalid
	}
	return value, nil
}

// cursorKey reads the key of the list cursors from CursorKeyFileSetting.
func cursorKey() ([]byte, error) {
	name, err := required(CursorKeyFileSetting)
	if err != nil {
		return nil, err
	}
	key, err := os.ReadFile(name)
	if err != nil {
		return nil, fmt.Errorf("%s: %w", CursorKeyFileSetting, err)
	}
	if len(key) < query.MinCursorKey {
		return nil, fmt.Errorf("%s names a key of %d bytes; the cursor key needs at least %d", CursorKeyFileSetting, len(key), query.MinCursorKey)
	}
	return key, nil
}

// required gives the value of the setting name, or an error that names it when it is empty.
func required(name string) (string, error) {
	value := os.Getenv(name)
	if value == "" {
		return "", fmt.Errorf("the setting %s is not set", name)
	}
	return value, nil
}

// quote quotes one SQL name.
func quote(name string) string { return `"` + strings.ReplaceAll(name, `"`, `""`) + `"` }
