// Package stegoruntime gives the service runtime of the runtime library (ST-SUP-RP14) what varies with the declaration
// of the service on the runtime data path (ST-SUP-RC01-OC41, ST-SUP-RC20-OC37): the names, the grants and the
// constructors of the component packages; service.New wires the runtimes and service.Migrate runs the migration job
// (ST-STD-RUNTIME-R05). It registers the routes of the declared commands and queries. The compiler writes this
// package for each service.
package stegoruntime

import (
	"context"
	"database/sql"
	"net/http"

	"google.golang.org/grpc"
	"gorm.io/driver/postgres"
	"gorm.io/gorm"
	gormlogger "gorm.io/gorm/logger"

	"github.com/jsell-rh/stego/registry/runtime/audit"
	stegoauthz "github.com/jsell-rh/stego/registry/runtime/authz"
	"github.com/jsell-rh/stego/registry/runtime/outbox"
	"github.com/jsell-rh/stego/registry/runtime/service"

	svcaudit {{printf "%q" .Audit}}
	svcauthz {{printf "%q" .Authz}}
	svcoutbox {{printf "%q" .Outbox}}
	svcstorage {{printf "%q" .Storage}}
	svctenancy {{printf "%q" .Tenancy}}
{{- if .Idempotency}}
	svcidempotency {{printf "%q" .Idempotency}}
{{- end}}
{{- if .API}}
	api {{printf "%q" .API}}
{{- end}}
{{- if .Commands}}
	commandhandlers {{printf "%q" .Commands}}
{{- end}}
{{- if .Queries}}
	queryserve {{printf "%q" .Queries}}
{{- end}}
)

// The declaration of the service.
const (
	// Service is the name of the service, which its audit rows and its telemetry carry.
	Service = {{printf "%q" .Service}}
	// DeclarationVersion is the SHA-256 of the declaration, which each audit row carries.
	DeclarationVersion = {{printf "%q" .DeclarationVersion}}
	// subjectType is the subject type of the schema that a verified identity maps to.
	subjectType = {{printf "%q" .SubjectType}}
	// tenantClaim is the dotted path of the claim that names the caller's tenant.
	tenantClaim = {{printf "%q" .TenantClaim}}
	// problemType and problemCode are the problem base and the problem code prefix of a refused credential.
	problemType = {{printf "%q" .ProblemType}}
	problemCode = {{printf "%q" .ProblemCode}}
)

// The settings of the verifier that the declaration states, through the settings of its auth provider; an empty one
// is not stated. A stated setting wins: the environment may only match it.
const (
	declaredIssuer    = {{printf "%q" .Issuer}}
	declaredAudience  = {{printf "%q" .Audience}}
	declaredHeader    = {{printf "%q" .Header}}
	declaredKeyFile   = {{printf "%q" .KeyFile}}
	declaredRoleClaim = {{printf "%q" .RoleClaim}}
)

// The roles of the database. RuntimeRole and OwnerRole are the tenancy component's. WorkerRole is the role that the
// outbox worker connects as and RelayRole the login role of the authorization relay; the database administrator
// creates both, with no login of the runtime role, before the first migration job.
const (
	RuntimeRole = svctenancy.RuntimeRole
	OwnerRole   = svctenancy.OwnerRole
	WorkerRole  = {{printf "%q" .WorkerRole}}
	RelayRole   = {{printf "%q" .RelayRole}}
)

// The settings of the deployment, which the process environment gives by the fixed names of the service runtime
// (ST-SUP-RP14-LC01).
const (
	DatabaseURLSetting              = service.DatabaseURLSetting
	DatabaseURLFileSetting          = service.DatabaseURLFileSetting
	MigrationDatabaseURLSetting     = service.MigrationDatabaseURLSetting
	MigrationDatabaseURLFileSetting = service.MigrationDatabaseURLFileSetting
	IssuerSetting                   = service.IssuerSetting
	AudienceSetting                 = service.AudienceSetting
	KeysURLSetting                  = service.KeysURLSetting
	KeysFileSetting                 = service.KeysFileSetting
	SpiceDBEndpointSetting          = service.SpiceDBEndpointSetting
	SpiceDBKeyFileSetting           = service.SpiceDBKeyFileSetting
	SpiceDBInsecureLoopbackSetting  = service.SpiceDBInsecureLoopbackSetting
	CursorKeyFileSetting            = service.CursorKeyFileSetting
	VersionSetting                  = service.VersionSetting
)

// grants are the privileges of the runtime role on the objects of the database access contract and on the
// idempotency keys, each without its grantee, which the migration job grants after it made the objects.
var grants = []string{
{{- range .Grants}}
	{{printf "%q" .}},
{{- end}}
}

// Runtime holds the runtime of the running service, which the service runtime wires (ST-SUP-RP14-LC02), and the
// routes of its declared commands and queries.
type Runtime struct {
	svc    *service.Service
	routes *http.ServeMux
}

// declared are the settings of the verifier that the declaration states.
var declared = service.Auth{Issuer: declaredIssuer, Audience: declaredAudience, Header: declaredHeader, KeyFile: declaredKeyFile,
	RoleClaim: declaredRoleClaim}

// parts are what varies with the declaration of the service, which service.New takes.
func parts() service.Parts {
	return service.Parts{
		Service: Service, DeclarationVersion: DeclarationVersion, SubjectType: subjectType, TenantClaim: tenantClaim,
		ProblemType: problemType, ProblemCode: problemCode, TenantConfig: svcstorage.TenantConfig,
		NewQueue:   func(db *sql.DB) (*outbox.Queue, error) { return svcoutbox.NewQueue(db, nil) },
		AuditQueue: func(q *outbox.Queue) (audit.Enqueuer, error) { return svcoutbox.AuditQueue(q) },
		NewAuthz: func(db *sql.DB, provider stegoauthz.Decision, q *outbox.Queue) (*stegoauthz.Runtime, error) {
			return svcauthz.NewRuntime(db, provider, q, nil)
		},
		AuditSettings: svcaudit.Settings,
{{- if .Commands}}
		Commands: commandhandlers.Entities(),
{{- end}}
{{- if .API}}
		Collections: api.Entities(),
{{- end}}
	}
}

// NewService builds the runtime of the service through the service runtime, from the settings of the deployment and
// the declaration (ST-SUP-RP14), and makes the command and query handlers, which Routes serves.
func NewService(ctx context.Context) (rt *Runtime, err error) {
	settings, err := service.ReadSettings(declared)
	if err != nil {
		return nil, err
	}
	svc, err := service.New(ctx, settings, parts())
	if err != nil {
		return nil, err
	}
	rt = &Runtime{svc: svc, routes: http.NewServeMux()}
	defer func() {
		if err != nil {
			_ = rt.Close()
			rt = nil
		}
	}()
{{- if .Commands}}
	if err = commandhandlers.Register(rt.routes, svc.Commands(), commandhandlers.BoundFills(), commandhandlers.Options{Retention: retention}); err != nil {
		return nil, err
	}
{{- end}}
{{- if .Queries}}
	queries, err := queryserve.New(queryserve.Config{Runtime: svc.Queries(), Verifier: svc.Verifier(), Probes: svc.Probes(), SubjectType: subjectType})
	if err != nil {
		return nil, err
	}
	queries.Routes(rt.routes)
{{- end}}
	return rt, nil
}

// retention is how long a completed idempotency key is kept: the declared retention, or zero for the runtime's
// default.
const retention = {{if .Idempotency}}svcidempotency.Retention{{else}}0{{end}}

// Middleware verifies the bearer token of each request before next; a request whose token the verifier refuses is
// answered 401 and reaches no handler.
func (rt *Runtime) Middleware(next http.Handler) http.Handler { return rt.svc.Middleware(next) }

// Routes serves the declared commands and queries, each at its route.
func (rt *Runtime) Routes() http.Handler { return rt.routes }
{{- if .API}}

// CollectionRuntime gives the Runtime of the collection handlers: their own command runtime, the query runtime and
// the probes.
func (rt *Runtime) CollectionRuntime() *api.Runtime {
	return &api.Runtime{Commands: rt.svc.Collections(), Queries: rt.svc.Queries(), Probes: rt.svc.Probes(), Retention: retention}
}
{{- end}}

// Close releases what NewService opened.
func (rt *Runtime) Close() error { return rt.svc.Close() }

// Migrate is the migration job of the service (tenant.MigrationJob), which the service runtime runs in its fixed
// order on one connection (ST-SUP-RP14-LC03): the ledger check and the ledger of the PostgreSQL adapter, the schema
// of the authorization component, the outbox, audit, idempotency and authorization migrations of the runtime library,
// the grants of the runtime role and the audit partitions.
func Migrate(ctx context.Context) error {
	settings, err := service.ReadMigrationSettings()
	if err != nil {
		return &service.StepError{Step: service.StepSettings, Err: err}
	}
	queueText, err := svcoutbox.Migration(RuntimeRole, WorkerRole)
	if err != nil {
		return &service.StepError{Step: service.StepSettings, Err: err}
	}
	auditText, err := svcaudit.Migration(RuntimeRole)
	if err != nil {
		return &service.StepError{Step: service.StepSettings, Err: err}
	}
	authzText, err := svcauthz.Migration(RuntimeRole, RelayRole, WorkerRole)
	if err != nil {
		return &service.StepError{Step: service.StepSettings, Err: err}
	}
	return service.Migrate(ctx, settings, service.Migration{
		OwnerRole: OwnerRole, RuntimeRole: RuntimeRole, TenantConfig: svcstorage.TenantConfig,
		LedgerCheck: func(ctx context.Context, conn *sql.Conn) error { return withLedger(ctx, conn, svcstorage.CheckLedger) },
		Ledger:      func(ctx context.Context, conn *sql.Conn) error { return withLedger(ctx, conn, svcstorage.Migrate) },
		Outbox:      queueText, Audit: auditText, Authorization: authzText,
		WriteSchema: func(ctx context.Context, conn grpc.ClientConnInterface) error { return svcauthz.WriteSchema(ctx, conn) },
		Grants:      grants,
	})
}

// withLedger runs a step of the PostgreSQL adapter's ledger on the migration job's connection.
func withLedger(ctx context.Context, conn *sql.Conn, step func(*gorm.DB) error) error {
	ledger, err := gorm.Open(postgres.New(postgres.Config{Conn: conn}), &gorm.Config{Logger: gormlogger.Discard, DisableAutomaticPing: true})
	if err != nil {
		return err
	}
	return step(ledger.WithContext(ctx))
}

// MigrationStage gives the stage of a failure of Migrate, such as migrate.ledger_check, which names the step and no
// error text, for the failure record of the process.
func MigrationStage(err error) string { return service.Stage(err) }
